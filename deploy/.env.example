APP_NAME="GT Driving"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Australia/Melbourne
APP_URL=https://REPLACE_WITH_DOMAIN
APP_DOMAIN=REPLACE_WITH_DOMAIN
APP_WWW_DOMAIN=www.REPLACE_WITH_DOMAIN

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

INSTRUCTOR_HOURLY_RATE=60
PAYMENT_CURRENCY=AUD

MAIL_MAILER=resend_smtp
MAIL_FROM_ADDRESS=hello@REPLACE_WITH_DOMAIN
MAIL_FROM_NAME="GT Driving"

# Create a restricted Resend sending key and store it only in the server-side
# deploy/.env file. Never commit or paste a live key into documentation.
RESEND_API_KEY=
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=587
RESEND_SMTP_ENCRYPTION=tls
